<!DOCTYPE html>
<html lang="id"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>CATUR RAJA</title>
<style>
*{box-sizing:border-box}body{background:#111;color:#fff;font-family:Arial;text-align:center;margin:0;padding:10px}
h1{color:#ffcc00;margin:5px} #info{background:#222;padding:10px;border-radius:10px;margin:10px}
#board{width:320px;max-width:95vw;margin:10px auto;display:grid;grid-template-columns:repeat(8,1fr);border:4px solid #ffcc00}
.cell{aspect-ratio:1;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer}
.w{background:#f0d9b5}.b{background:#b58863}.sel{outline:4px solid yellow}.hint{outline:4px solid lime}
button{background:#ffcc00;border:0;padding:10px 15px;border-radius:10px;font-weight:bold;margin:5px}
</style></head>
<body>
<h1>♞ CATUR RAJA ♞</h1>
<div id="info"><b id="turn">Giliran: Putih ⚪</b><br><span id="msg">Klik bidak, lalu klik kotak tujuan</span></div>
<div id="board"></div>
<button onclick="location.reload()">🔄 Ulangi Game</button>
<script>
let board=[
["♜","♞","♝","♛","♚","♝","♞","♜"],
["♟","♟","♟","♟","♟","♟","♟","♟"],
["","","","","","","",""],
["","","","","","","",""],
["","","","","","","",""],
["","","","","","","",""],
["♙","♙","♙","♙","♙","♙","♙","♙"],
["♖","♘","♗","♕","♔","♗","♘","♖"]];
let turn='w',sel=null;
let white="♔♕♖♗♘♙",black="♚♛♜♝♞♟";
function draw(){
 let b=document.getElementById('board');b.innerHTML='';
 for(let r=0;r<8;r++)for(let c=0;c<8;c++){
  let d=document.createElement('div');
  d.className='cell '+((r+c)%2==0?'w':'b');
  d.textContent=board[r][c];
  if(sel&&sel[0]==r&&sel[1]==c)d.classList.add('sel');
  d.onclick=()=>click(r,c);b.appendChild(d);
 }
 document.getElementById('turn').textContent='Giliran: '+(turn=='w'?'Putih ⚪':'Hitam ⚫');
}
function click(r,c){
 let p=board[r][c];
 if(sel){
  if(board[r][c]==''||(turn=='w'&&black.includes(p))||(turn=='b'&&white.includes(p))){
   board[r][c]=board[sel[0]][sel[1]];board[sel[0]][sel[1]]='';sel=null;
   turn=turn=='w'?'b':'w';
   document.getElementById('msg').textContent='Pindah! Giliran selanjutnya';
  }else{sel=null;}
 }else{
  if(p!=''&&((turn=='w'&&white.includes(p))||(turn=='b'&&black.includes(p)))){
   sel=[r,c];document.getElementById('msg').textContent='Bidak dipilih, klik kotak tujuan';
  }
 }
 draw();
}
draw();
</script>
</body></html>
